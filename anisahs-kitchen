'use strict';
const canvas=document.querySelector('#game'),ctx=canvas.getContext('2d');
const ui={score:document.querySelector('#score'),level:document.querySelector('#level'),time:document.querySelector('#time'),held:document.querySelector('#held'),orders:document.querySelector('#orders'),message:document.querySelector('#message'),pause:document.querySelector('#pause')};
const W=800,H=560,T=80;
const stations=[{x:1,y:1,type:'bun',emoji:'🍞',name:'Buns'},{x:3,y:1,type:'tomato',emoji:'🍅',name:'Tomatoes'},{x:5,y:1,type:'lettuce',emoji:'🥬',name:'Lettuce'},{x:8,y:1,type:'patty',emoji:'🥩',name:'Raw patties'},{x:1,y:5,type:'chop',emoji:'🔪',name:'Chopping'},{x:4,y:5,type:'stove',emoji:'🍳',name:'Stove'},{x:7,y:5,type:'plate',emoji:'🍽️',name:'Assembly'},{x:8,y:3,type:'serve',emoji:'🛎️',name:'Serve'}];
let state,keys=new Set(),last=0,spawnClock=0,uiClock=0;
function reset(){state={player:{x:3.5*T,y:3.3*T},held:null,prepared:[],score:0,level:1,time:120,orders:[],paused:false,over:false,stationTask:null,notice:'Grab ingredients, then prepare a burger!',noticeUntil:performance.now()+5000};spawnClock=0;uiClock=0;addOrder();syncUI();}
function notify(s){state.notice=s;state.noticeUntil=performance.now()+3000;ui.message.textContent=s;}
function addOrder(){const n=state.level;const ingredients=['bun','patty'];if(n>1||Math.random()>.45)ingredients.push('tomato');if(n>2||Math.random()>.5)ingredients.push('lettuce');state.orders.push({ingredients,remaining:Math.max(32,65-n*3),id:Math.random()});}
const names={bun:'🍞 Bun',patty:'🥩 Raw patty',cookedPatty:'🍖 Cooked patty',tomato:'🍅 Tomato',choppedTomato:'🍅 Chopped tomato',lettuce:'🥬 Lettuce',choppedLettuce:'🥬 Chopped lettuce'};
function nearby(){let best=null,d=Infinity;for(const s of stations){const a=Math.hypot(state.player.x-(s.x+.5)*T,state.player.y-(s.y+.5)*T);if(a<110&&a<d){best=s;d=a;}}return best;}
function interact(){if(state.paused||state.over)return;const s=nearby();if(!s){notify('Move closer to a station.');return;}const held=state.held;
if(['bun','tomato','lettuce','patty'].includes(s.type)){if(held){notify('Your hands are full! Use a station first.');return;}state.held=s.type;notify('Picked up '+names[s.type]);}
else if(s.type==='chop'){if(held==='tomato'||held==='lettuce'){state.held='chopped'+held[0].toUpperCase()+held.slice(1);notify('Chopped '+held+'!');}else notify('Bring a tomato or lettuce here.');}
else if(s.type==='stove'){if(held==='patty'){state.held=null;state.stationTask={time:4,elapsed:0,ready:false,burn:0};notify('Patty is cooking! Come back in 4 seconds.');}else if(!held&&state.stationTask?.ready){state.held='cookedPatty';state.stationTask=null;notify('Picked up cooked patty!');}else notify(state.stationTask?'Patty is still cooking.':'Bring a raw patty to cook.');}
else if(s.type==='plate'){if(held){if(!state.prepared.includes(held)){state.prepared.push(held);notify('Added '+names[held]+' to the plate.');}else notify('Already on the plate!');state.held=null;}else if(state.prepared.length){state.prepared=[];notify('Cleared the plate.');}else notify('Bring prepared ingredients here.');}
else if(s.type==='serve'){const idx=state.orders.findIndex(o=>o.ingredients.every(i=>state.prepared.includes(i==='patty'?'cookedPatty':i==='tomato'?'choppedTomato':i==='lettuce'?'choppedLettuce':i))&&state.prepared.length===o.ingredients.length);if(idx>=0){const o=state.orders.splice(idx,1)[0];state.score+=100+Math.ceil(o.remaining)*2;state.prepared=[];state.level=1+Math.floor(state.score/600);state.time=Math.min(180,state.time+8);notify('Perfect order! +points and +8 seconds! 🎉');if(!state.orders.length)addOrder();}else notify('Plate does not match an order!');}
syncUI();}
function syncUI(){ui.score.textContent='⭐ Score: '+state.score;ui.level.textContent='🏆 Level: '+state.level;ui.time.textContent='⏱ '+Math.ceil(state.time)+'s';ui.held.textContent='👐 Holding: '+(names[state.held]||'Nothing');ui.orders.innerHTML='';for(const o of state.orders){const el=document.createElement('div');el.className='order';const label=document.createElement('strong');label.textContent='🍔 '+o.ingredients.map(i=>i==='patty'?'Burger':i[0].toUpperCase()+i.slice(1)).join(' + ');const timer=document.createElement('small');timer.textContent='⏳ '+Math.ceil(o.remaining)+' seconds';el.append(label,timer);ui.orders.append(el);}ui.pause.textContent=state.paused?'Resume ▶':'Pause ⏸';}
function update(dt){if(state.paused||state.over)return;const p=state.player;let dx=0,dy=0;if(keys.has('arrowleft')||keys.has('a'))dx--;if(keys.has('arrowright')||keys.has('d'))dx++;if(keys.has('arrowup')||keys.has('w'))dy--;if(keys.has('arrowdown')||keys.has('s'))dy++;if(dx||dy){const length=Math.hypot(dx,dy),speed=205;p.x=Math.max(30,Math.min(W-30,p.x+dx/length*speed*dt));p.y=Math.max(30,Math.min(H-30,p.y+dy/length*speed*dt));for(const s of stations){const sx=s.x*T+7,sy=s.y*T+7;if(p.x>sx-16&&p.x<sx+T-7&&p.y>sy-16&&p.y<sy+T-7){p.x=Math.max(30,Math.min(W-30,p.x-dx/length*speed*dt));p.y=Math.max(30,Math.min(H-30,p.y-dy/length*speed*dt));}}}
state.time-=dt;spawnClock+=dt;uiClock+=dt;for(const o of state.orders)o.remaining-=dt;if(state.orders.some(o=>o.remaining<=0)){state.orders=state.orders.filter(o=>o.remaining>0);state.score=Math.max(0,state.score-75);notify('Order missed! -75 points.');}if(spawnClock>Math.max(8,20-state.level*1.5)&&state.orders.length<Math.min(4,1+Math.ceil(state.level/2))){spawnClock=0;addOrder();}if(state.stationTask){const t=state.stationTask;t.elapsed+=dt;if(t.elapsed>=t.time)t.ready=true;if(t.ready)t.burn+=dt;if(t.burn>12){state.stationTask=null;notify('Oh no! The patty burned! 🔥');}}if(state.time<=0){state.time=0;state.over=true;notify('Kitchen closed! Final score: '+state.score+'. Press R to restart.');}if(uiClock>.2){uiClock=0;syncUI();}}
function rounded(x,y,w,h,r,color){ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill();}
function draw(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#fbe4b9';ctx.fillRect(0,0,W,H);ctx.strokeStyle='#efd1a3';ctx.lineWidth=2;for(let x=0;x<W;x+=T){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}for(let y=0;y<H;y+=T){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
for(const s of stations){const x=s.x*T+6,y=s.y*T+6;rounded(x+3,y+5,70,70,13,'#9c6a58');rounded(x,y,70,66,12,s.type==='serve'?'#ffbb7b':s.type==='stove'?'#777b88':'#f6fafb');ctx.font='33px system-ui';ctx.textAlign='center';ctx.fillText(s.emoji,x+35,y+42);ctx.font='bold 11px system-ui';ctx.fillStyle='#49352f';ctx.fillText(s.name,x+35,y+58);if(s.type==='stove'&&state.stationTask){ctx.font='12px system-ui';ctx.fillText(state.stationTask.ready?'READY!':Math.ceil(state.stationTask.time-state.stationTask.elapsed)+'s',x+35,y+14);}}
const p=state.player;ctx.fillStyle='#6d394c';ctx.beginPath();ctx.ellipse(p.x,p.y+17,23,9,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#e76b91';ctx.beginPath();ctx.arc(p.x,p.y,21,0,Math.PI*2);ctx.fill();ctx.fillStyle='#f1b98e';ctx.beginPath();ctx.arc(p.x,p.y-8,13,0,Math.PI*2);ctx.fill();ctx.font='28px system-ui';ctx.fillText('👩‍🍳',p.x,p.y+5);if(state.held){ctx.font='24px system-ui';ctx.fillText(names[state.held].split(' ')[0],p.x+24,p.y-20);}
rounded(12,12,340,44,10,'#fffaf0');ctx.fillStyle='#684552';ctx.textAlign='left';ctx.font='bold 14px system-ui';ctx.fillText('🍽️ Plate: '+(state.prepared.map(i=>names[i]?.split(' ')[0]).join(' ')||'Empty'),25,39);const n=nearby();if(n&&!state.paused&&!state.over){rounded(250,493,300,45,12,'#fff9e9');ctx.textAlign='center';ctx.fillStyle='#6d394c';ctx.fillText('Press E / Space: '+n.name,400,521);}if(state.paused||state.over){ctx.fillStyle='#281822bd';ctx.fillRect(0,0,W,H);ctx.textAlign='center';ctx.fillStyle='white';ctx.font='bold 44px system-ui';ctx.fillText(state.over?'Kitchen Closed!':'Paused',W/2,H/2-15);ctx.font='22px system-ui';ctx.fillText(state.over?'Press R to play again':'Press Enter to resume',W/2,H/2+27);}}
function frame(t){const dt=Math.min(.05,(t-last)/1000||0);last=t;update(dt);draw();requestAnimationFrame(frame);}function pause(){if(state.over)return;state.paused=!state.paused;syncUI();}
document.addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k))e.preventDefault();if(!e.repeat&&(k==='e'||k===' '))interact();if(!e.repeat&&k==='enter')pause();if(!e.repeat&&k==='r'&&state.over)reset();keys.add(k);});document.addEventListener('keyup',e=>keys.delete(e.key.toLowerCase()));window.addEventListener('blur',()=>keys.clear());ui.pause.addEventListener('click',pause);reset();requestAnimationFrame(frame);
